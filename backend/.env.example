# Copy to .env and fill in as needed. Secrets NEVER go to the client.
DEMO_MODE=true
# Provider fault-injection knobs in POST /chat are honored ONLY when DEMO_MODE=true.
# Control-plane writes (PATCH /registry) default to DEMO_MODE; force with this flag.
ALLOW_CONTROL_PLANE_WRITES=
CORS_ORIGINS=http://localhost:3000
DETECTOR_TIMEOUT_S=2.0
PROVIDER_TIMEOUT_S=4.0

# Guardrail Service hardening (Cycle 2)
GUARDRAIL_STRATEGY=parallel      # parallel (full attribution) | cascade (cost-first, short-circuit)
SIGNAL_CACHE_ENABLED=true
SIGNAL_CACHE_MAX=2048
SIGNAL_CACHE_TTL_S=300
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_TIMEOUT_S=30

# Real providers (Cycle 7). Leave PROVIDER_CHAIN blank to stay on the mock chain.
PROVIDER_CHAIN=            # e.g. openai,anthropic,mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-5

# ML sidecar (Cycle 6)
ML_SERVICE_URL=           # e.g. http://localhost:8100
ML_TIMEOUT_S=1.5

# Rate limiting + budget (Cycle 7)
RATE_CAPACITY=30
RATE_REFILL_PER_S=0.5
TOKEN_BUDGET_PER_DAY=200000

# Durable audit (Cycle 7). Empty = in-memory only.
AUDIT_DB=                 # e.g. /data/audit.db
# Admin key gating control-plane writes (else DEMO_MODE flag applies)
ADMIN_API_KEY=

# Plugin safety / blast radius (Cycle 8)
ALLOW_EXTERNAL_EGRESS=true   # false = skip detectors that send data off-box
MAX_INPUT_CHARS=16000
